# Contact form. Without a key the footer falls back to a mailto link.
# Get one at https://resend.com -> API Keys. Add the same key to Vercel
# (Settings -> Environment Variables) for Production and Preview.
RESEND_API_KEY=

# The From address Resend sends as. Must be on a domain verified in Resend;
# onboarding@resend.dev works for testing and only delivers to your own inbox.
CONTACT_FROM="NONTHANAPHONG.EXE <onboarding@resend.dev>"
