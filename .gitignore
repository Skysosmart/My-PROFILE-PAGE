# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts


# local backups of pre-recompression certificate scans
data/certificates-originals/

# originals that the site never serves (kept locally, not in the repo)
public/portrait/MeNameSky.jpg
data/Certificates/

# only npm is used (Vercel runs npm ci)
bun.lock*

# env
.env
.env.*
!.env.example
.eslintcache

# copied from the v86 package by scripts/vm-assets.sh (npm prebuild), so they
# always match the installed version. The ISO and the BIOS pair beside them
# are vendored, since they come from elsewhere and never change.
/public/vm/libv86.mjs
/public/vm/v86.wasm
